PORT=3000
APP_URL=http://localhost:3000

# Max upload size in bytes (default 1 GB)
MAX_FILE_SIZE=1073741824

# Expiration: days until files are deleted (0 = disabled)
FILE_EXPIRATION_DAYS=0

# Storage: local | s3
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage

# S3-compatible (MinIO, R2, AWS)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=fike
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

DATABASE_PATH=./data/fike.db

# Rate limits (per IP)
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
RATE_LIMIT_DOWNLOAD_MAX=120
RATE_LIMIT_DOWNLOAD_WINDOW_MS=60000
